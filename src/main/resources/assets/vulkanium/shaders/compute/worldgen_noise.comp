float fade(float t) {
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

float grad2(int hash, float x, float y) {
    int h = hash & 7;
    float u = h < 4 ? x : y;
    float v = h < 4 ? y : x;
    return ((h & 1) != 0 ? -u : u) + ((h & 2) != 0 ? -2.0 * v : 2.0 * v);
}

float perlinNoise2D(float x, float y) {
    int X = int(floor(x)) & 255;
    int Y = int(floor(y)) & 255;

    x -= floor(x);
    y -= floor(y);

    float u = fade(x);
    float v = fade(y);

    int aa = perm[perm[X] + Y];
    int ab = perm[perm[X] + Y + 1];
    int ba = perm[perm[X + 1] + Y];
    int bb = perm[perm[X + 1] + Y + 1];

    return mix(
        mix(grad2(aa, x, y),     grad2(ba, x - 1.0, y),     u),
        mix(grad2(ab, x, y - 1.0), grad2(bb, x - 1.0, y - 1.0), u),
        v
    );
}

// Fractal Brownian Motion (multi-octave)
float fbm2D(float x, float y, uint octaves, float freq, float amp,
            float lacun, float persist) {
    float sum = 0.0;
    float f = freq;
    float a = amp;

    for (uint i = 0; i < octaves; i++) {
        sum += a * perlinNoise2D(x * f, y * f);
        f *= lacun;
        a *= persist;
    }
    return sum;
}

void main() {
    uint chunkIdx = gl_WorkGroupID.x + chunkOffset;
    if (chunkIdx >= totalChunks) return;

    uint localX = gl_LocalInvocationID.x;
    uint localZ = gl_LocalInvocationID.y;

    // Read noise parameters for this chunk
    uint baseParam = chunkIdx * 10; // 40 bytes / 4 = 10 uints
    uint seed = params[baseParam + 0];
    uint octaves = params[baseParam + 1];
    float frequency = uintBitsToFloat(params[baseParam + 2]);
    float amplitude = uintBitsToFloat(params[baseParam + 3]);
    float lacunarity = uintBitsToFloat(params[baseParam + 4]);
    float persistence = uintBitsToFloat(params[baseParam + 5]);
    int chunkX = int(params[baseParam + 6]);
    int chunkZ = int(params[baseParam + 7]);
    uint noiseType = params[baseParam + 8];

    // World-space coordinates
    float worldX = float(chunkX * 16 + int(localX)) + float(seed & 0xFFFFu) * 0.001;
    float worldZ = float(chunkZ * 16 + int(localZ)) + float((seed >> 16) & 0xFFFFu) * 0.001;

    float value;
    if (noiseType == 0) {
        // Perlin FBM
        value = fbm2D(worldX, worldZ, octaves, frequency, amplitude, lacunarity, persistence);
    } else if (noiseType == 1) {
        // Simplex (approximate via perlin with offset)
        value = fbm2D(worldX + 31.7, worldZ + 47.3, octaves, frequency, amplitude, lacunarity, persistence);
    } else {
        // Voronoi (simplified)
        float cellX = floor(worldX * frequency);
        float cellZ = floor(worldZ * frequency);
        float minDist = 1e10;
        for (int dz = -1; dz <= 1; dz++) {
            for (int dx = -1; dx <= 1; dx++) {
                float cx = cellX + float(dx);
                float cz = cellZ + float(dz);
                // Pseudo-random cell center
                float rx = cx + fract(sin(cx * 12.9898 + cz * 78.233) * 43758.5453);
                float rz = cz + fract(sin(cx * 93.9898 + cz * 67.345) * 23421.631);
                float d = distance(vec2(worldX * frequency, worldZ * frequency), vec2(rx, rz));
                minDist = min(minDist, d);
            }
        }
        value = minDist * amplitude;
    }

    // Write output
    uint outputIdx = chunkIdx * 256 + localZ * 16 + localX;
    noiseValues[outputIdx] = value;
}
