#version 450

// GPU Perlin/Simplex noise generator for world generation
// Each workgroup computes noise for one chunk (2D) or section slice (3D)

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Binding 0: Noise parameters per chunk request
layout(set = 0, binding = 0, std430) readonly buffer NoiseParams {
    // Per-request: seed(4), octaves(4), frequency(4), amplitude(4),
    //              lacunarity(4), persistence(4), chunkX(4), chunkZ(4),
    //              noiseType(4), dimensions(4) = 40 bytes
    uint params[];
};

// Binding 1: Output noise values (float per sample)
layout(set = 0, binding = 1, std430) writeonly buffer NoiseOutput {
    float noiseValues[];
};

// Push constants: chunk index offset
layout(push_constant) uniform PushConstants {
    uint chunkOffset;
    uint totalChunks;
};

// ── Noise utility functions ──

