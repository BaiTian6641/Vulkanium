#version 460
#extension GL_EXT_ray_tracing : require

// Ray generation shader — primary camera rays
// Dispatched at screen resolution, one thread per pixel

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS;
layout(set = 0, binding = 1, rgba16f) uniform image2D outImage;

layout(set = 0, binding = 2, std140) uniform CameraData {
    mat4 viewInverse;
    mat4 projInverse;
    vec3 cameraPosition;
    float time;
    uint frameIndex;
    uint maxBounces;
    float sunAngle;
    float padding;
} camera;

layout(location = 0) rayPayloadEXT struct RayPayload {
    vec3 color;
    float distance;
    vec3 normal;
    uint bounceCount;
} payload;

void main() {
    vec2 pixelCenter = vec2(gl_LaunchIDEXT.xy) + vec2(0.5);
    vec2 uv = pixelCenter / vec2(gl_LaunchSizeEXT.xy);
    vec2 ndc = uv * 2.0 - 1.0;

    // Compute ray origin and direction from inverse camera matrices
    vec4 origin = camera.viewInverse * vec4(0.0, 0.0, 0.0, 1.0);
    vec4 target = camera.projInverse * vec4(ndc.x, ndc.y, 1.0, 1.0);
    target /= target.w;
    vec4 direction = camera.viewInverse * vec4(normalize(target.xyz), 0.0);

    payload.color = vec3(0.0);
    payload.distance = -1.0;
    payload.normal = vec3(0.0);
    payload.bounceCount = 0;

    traceRayEXT(
        topLevelAS,
        gl_RayFlagsOpaqueEXT,
        0xFF,              // cull mask
        0,                 // SBT record offset
        0,                 // SBT record stride
        0,                 // miss shader index
        origin.xyz,
        0.001,             // tMin
        direction.xyz,
        10000.0,           // tMax
        0                  // payload location
    );

    imageStore(outImage, ivec2(gl_LaunchIDEXT.xy), vec4(payload.color, 1.0));
}
